<UserControl x:Class="MeuOrcamento.Editors.AllocationEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MeuOrcamento.Controls">
    <StackPanel>
        <TextBlock x:Name="Intro" Style="{StaticResource Note}" Margin="0,0,0,28" />

        <c:StripChart x:Name="Preview" ShowStatus="False" Margin="0,0,0,24" />

        <Grid Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition />
                <ColumnDefinition Width="204" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Nº" Style="{StaticResource Label}" />
            <TextBlock Grid.Column="1" Text="CATEGORIA" Style="{StaticResource Label}" />
            <TextBlock Grid.Column="2" Text="TIPO" Style="{StaticResource Label}" Margin="16,0,0,0" />
            <TextBlock Grid.Column="3" Text="% RENDA" Style="{StaticResource Label}" TextAlignment="Right" />
            <TextBlock Grid.Column="4" Text="VALOR · R$" Style="{StaticResource Label}" TextAlignment="Right" />
        </Grid>
        <Border Height="1" Background="{DynamicResource RuleStrong}" Margin="0,8,0,0" />
        <StackPanel x:Name="RowsPanel" />

        <DockPanel Margin="0,14,0,0">
            <TextBlock x:Name="Summary" DockPanel.Dock="Right" Style="{StaticResource LabelBright}" VerticalAlignment="Center" />
            <Button x:Name="AddButton" Style="{StaticResource TextButton}" Content="+ ADICIONAR CATEGORIA" HorizontalAlignment="Left" Click="Add_Click" />
        </DockPanel>
        <TextBlock x:Name="RowsWarning" Style="{StaticResource Label}" Foreground="{DynamicResource Alert}" TextWrapping="Wrap" TextTrimming="None" Margin="0,12,0,0" />
        <TextBlock Style="{StaticResource Help}" Margin="0,24,0,0"
                   Text="Em % a parte acompanha a renda; em R$ fica um valor fixo, como o aluguel. Renomear ou mudar o tipo vale deste mês em diante; os meses anteriores ficam como estavam." />
    </StackPanel>
</UserControl>
